generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionMode {
  FAMILY
  DEEP_DIVE
}

model Question {
  id        String       @id @default(cuid())
  optionA   String
  optionB   String
  votesA    Int          @default(0)
  votesB    Int          @default(0)
  isActive  Boolean      @default(true)
  mode      QuestionMode?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  seenBy    SeenQuestion[]

  @@index([isActive, mode, createdAt])
}

// Records which questions a signed-in user has already voted on, so those
// questions are not shown to them again until they refresh their pool.
// `userId` is the Clerk user id; guests are never recorded here.
model SeenQuestion {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}
